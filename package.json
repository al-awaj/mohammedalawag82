{
  "name": "events-platform",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "e2e"
  ],
  "scripts": {
    "test": "npm --workspace apps/api test",
    "typecheck": "npm --workspaces --if-present run typecheck",
    "dev:api": "npm --workspace apps/api run dev",
    "dev:admin": "npm --workspace apps/admin run dev",
    "dev:provider": "npm --workspace apps/provider run dev",
    "dev:web": "npm --workspace apps/web run dev",
    "test:e2e": "npm --workspace e2e test",
    "start:local": "node scripts/start-local.mjs",
    "build:web": "npm run build -w apps/admin -w apps/provider -w apps/web"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native-worklets": "0.10.1",
    "react-native-reanimated": "4.5.1"
  }
}
