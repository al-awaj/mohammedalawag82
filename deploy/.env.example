# ---- Domains (DNS A/AAAA records must point to this server before the first start)
WEB_DOMAIN=www.example.org
ADMIN_DOMAIN=admin.example.org
PROVIDER_DOMAIN=partners.example.org
API_DOMAIN=api.example.org
ACME_EMAIL=ops@example.org

# ---- Branding (built into the web interfaces; rebuild after changing)
BRAND_AR=مناسبات
BRAND_EN=Occasions

# ---- Database (use a long random password; never the development one)
POSTGRES_USER=events
POSTGRES_PASSWORD=
POSTGRES_DB=events

# ---- Security: openssl rand -base64 48
JWT_SECRET=

# ---- File storage: local (the "storage" volume) or s3 (a PRIVATE bucket)
STORAGE_DRIVER=local
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_FORCE_PATH_STYLE=false
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ---- Backups kept in ./backups
BACKUP_KEEP=14

# ---- Images (when pulling prebuilt images from a registry instead of building here)
# IMAGE_PREFIX=ghcr.io/<org>/events
# IMAGE_TAG=1.0.0
