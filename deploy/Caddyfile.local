# Local trial of the production stack: certificates from Caddy's own local CA (no internet needed).
{
	local_certs
}

(common) {
	encode zstd gzip
	header -Server
}

{$WEB_DOMAIN} {
	import common
	reverse_proxy web:3000
}

{$ADMIN_DOMAIN} {
	import common
	reverse_proxy admin:3000
}

{$PROVIDER_DOMAIN} {
	import common
	reverse_proxy provider:3000
}

{$API_DOMAIN} {
	import common
	reverse_proxy api:3000
}
