{
	email {$ACME_EMAIL}
}

(common) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	log
}

{$WEB_DOMAIN} {
	import common
	reverse_proxy web:3000
}

{$ADMIN_DOMAIN} {
	import common
	reverse_proxy admin:3000
}

{$PROVIDER_DOMAIN} {
	import common
	reverse_proxy provider:3000
}

# Used directly by the mobile app and by payment gateways (webhooks).
{$API_DOMAIN} {
	import common
	request_body {
		max_size 110MB
	}
	reverse_proxy api:3000
}
