NODE_ENV=development
PORT=3000
HOST=0.0.0.0
DATABASE_URL=postgres://app:app@localhost:5432/events_dev
# At least 32 random characters. Generate: openssl rand -base64 48
JWT_SECRET=change-me-change-me-change-me-change-me
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003
# Proxies allowed to set X-Forwarded-For (the web interfaces' server and any load balancer). Hop count or IP/CIDR list.
TRUST_PROXY=loopback
STORAGE_DIR=./storage
MAX_UPLOAD_BYTES=10485760
# Payment integration secrets: one variable per integration, named in the integration's secretRef.
# Never commit real values. Example for a sandbox integration created with secretRef=PAY_SANDBOX_SA_SECRET:
# PAY_SANDBOX_SA_SECRET=at-least-16-random-characters
